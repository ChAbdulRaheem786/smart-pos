# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/pos-system?retryWrites=true&w=majority

# Admin panel password (plain text is fine here, it's compared server-side only)
ADMIN_PASSWORD=changeme123

# Secret used to sign the admin JWT session token — make this long & random
ADMIN_JWT_SECRET=replace_with_a_long_random_string

# How long an admin login session lasts
ADMIN_JWT_EXPIRES_IN=7d

# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

PORT=5000
